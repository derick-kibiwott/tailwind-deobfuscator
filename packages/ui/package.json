{
  "name": "@tailwind-deobfuscator/ui",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./styles/*": "./styles/*",
    "./types/*": "./src/types/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./*": "./src/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "build:css": "tailwindcss -i ./styles/globals.css -o ./styles/globals-built.css --minify",
    "dev:css": "@tailwindcss -i ./styles/globals.css -o ./styles/globals-built.css --watch"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/cli": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.7.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
